#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "husky"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "husky"
{
    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0

            over "front_left_wheel_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.02467, 0.04411, 0.02467, 0, 0, 0]
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.02467, 0.02467, 0.04411)
                float physics:mass = 2.637
                quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                over "cylinder" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "front_right_wheel_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.02467, 0.04411, 0.02467, 0, 0, 0]
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.02467, 0.02467, 0.04411)
                float physics:mass = 2.637
                quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                over "cylinder" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "rear_left_wheel_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.02467, 0.04411, 0.02467, 0, 0, 0]
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.02467, 0.02467, 0.04411)
                float physics:mass = 2.637
                quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                over "cylinder" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "rear_right_wheel_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.02467, 0.04411, 0.02467, 0, 0, 0]
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.02467, 0.02467, 0.04411)
                float physics:mass = 2.637
                quatf physics:principalAxes = (-0.70710677, 0.70710677, 0, 0)

                over "cylinder" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }

            over "top_chassis_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
            }

            over "front_bumper_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
            }

            over "rear_bumper_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
            }

            over "user_rail_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
            }

            over "top_plate_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
            )
            {
            }

            over "box" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }

            over "box_1" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }

            over "inertial_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.6022, 1.7386, 2.0296, -0.02364, -0.1197, -0.001544]
                point3f physics:centerOfMass = (-0.00065, -0.085, 0.062)
                float3 physics:diagonalInertia = (0.5917425, 1.7390887, 2.039569)
                float physics:mass = 46.034
                quatf physics:principalAxes = (0.9990835, -0.0011322651, -0.04153282, 0.010286936)
            }
        }
    }

    over "Physics"
    {
        def PhysicsRevoluteJoint "front_left_wheel" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.017453292
            float drive:angular:physics:stiffness = 1.7453293
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/front_left_wheel_link>
            point3f physics:localPos0 = (0.256, 0.2775, 0.03282)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "front_right_wheel" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.017453292
            float drive:angular:physics:stiffness = 1.7453293
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/front_right_wheel_link>
            point3f physics:localPos0 = (0.256, -0.2775, 0.03282)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "rear_left_wheel" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.017453292
            float drive:angular:physics:stiffness = 1.7453293
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/rear_left_wheel_link>
            point3f physics:localPos0 = (-0.256, 0.2775, 0.03282)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsRevoluteJoint "rear_right_wheel" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.017453292
            float drive:angular:physics:stiffness = 1.7453293
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Y"
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/rear_right_wheel_link>
            point3f physics:localPos0 = (-0.256, -0.2775, 0.03282)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </husky>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "inertial_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/inertial_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "top_chassis_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/top_chassis_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "front_bumper"
        {
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/front_bumper_link>
            point3f physics:localPos0 = (0.48, 0, 0.091)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "rear_bumper"
        {
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/rear_bumper_link>
            point3f physics:localPos0 = (-0.48, 0, 0.091)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0.0000013267949, 0, 0, 1)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "user_rail"
        {
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/user_rail_link>
            point3f physics:localPos0 = (0.272, 0, 0.245)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }

        def PhysicsFixedJoint "top_plate_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </husky/Geometry/base_link>
            custom rel physics:body1
            append rel physics:body1 = </husky/Geometry/base_link/top_plate_link>
            point3f physics:localPos0 = (0.0812, 0, 0.245)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

