#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "husky"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "husky"
{
    over "Physics"
    {
        over "front_left_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "front_right_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rear_left_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

        over "rear_right_wheel" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }
    }
}

