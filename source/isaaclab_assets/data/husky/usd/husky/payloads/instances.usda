#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Scope "Instances"
{
    def Xform "base_link" (
        prepend references = @./geometries.usd@</Geometries/base_link>
    )
    {
        over "base_link" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/base_link/VisualMaterials/Dark>
        }

        def Scope "VisualMaterials"
        {
            def Material "Dark" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Dark>
            )
            {
            }
        }
    }

    def Xform "wheel" (
        prepend references = @./geometries.usd@</Geometries/wheel>
    )
    {
        over "wheel" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/wheel/VisualMaterials/Grey>
        }

        def Scope "VisualMaterials"
        {
            def Material "Grey" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Grey>
            )
            {
            }
        }
    }

    def Xform "top_chassis" (
        prepend references = @./geometries.usd@</Geometries/top_chassis>
    )
    {
        over "top_chassis" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/top_chassis/VisualMaterials/Yellow>
        }

        def Scope "VisualMaterials"
        {
            def Material "Yellow" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Yellow>
            )
            {
            }
        }
    }

    def Xform "bumper" (
        prepend references = @./geometries.usd@</Geometries/bumper>
    )
    {
        over "bumper" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/bumper/VisualMaterials/Dark_1>
        }

        def Scope "VisualMaterials"
        {
            def Material "Dark_1" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Dark>
            )
            {
            }
        }
    }

    def Xform "user_rail" (
        prepend references = @./geometries.usd@</Geometries/user_rail>
    )
    {
        over "user_rail" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/user_rail/VisualMaterials/Dark_2>
        }

        def Scope "VisualMaterials"
        {
            def Material "Dark_2" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Dark>
            )
            {
            }
        }
    }

    def Xform "top_plate" (
        prepend references = @./geometries.usd@</Geometries/top_plate>
    )
    {
        over "top_plate" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/top_plate/VisualMaterials/Dark_3>
        }

        def Scope "VisualMaterials"
        {
            def Material "Dark_3" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/Dark_3>
            )
            {
            }
        }
    }

    def Xform "top_plate_1" (
        prepend references = @./geometries.usd@</Geometries/top_plate_1>
    )
    {
        over "top_plate_1" (
            apiSchemas = ["PhysicsCollisionAPI", "NewtonCollisionAPI", "PhysicsMeshCollisionAPI", "NewtonMeshCollisionAPI"]
        )
        {
            token physics:approximation = "convexHull"
            token purpose = "guide"
        }
    }
}

